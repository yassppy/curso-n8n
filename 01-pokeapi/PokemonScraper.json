        "sendTo": "miguemallquidiaz@gmail.com",
        "subject": "El proceso de actualización termino",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:680px;margin:auto;color:#111\">\n\n  <div style=\"border-bottom:2px solid #185FA5;padding-bottom:12px;margin-bottom:20px\">\n    <div style=\"font-size:11px;color:#185FA5;font-weight:bold;letter-spacing:1px\">\n      N8N · NOTIFICACIÓN AUTOMÁTICA\n    </div>\n\n    <h2 style=\"margin:6px 0 0;font-size:21px\">\n      Registro de Pokémon completado\n    </h2>\n\n    <p style=\"margin:6px 0 0;color:#666;font-size:13px\">\n      Los siguientes Pokémon fueron registrados correctamente en Google Sheets.\n    </p>\n  </div>\n\n  <table style=\"width:100%;border-collapse:collapse;font-size:14px\">\n    <thead>\n      <tr style=\"background:#E6F1FB\">\n        <th style=\"padding:10px;text-align:left;color:#0C447C\">#</th>\n        <th style=\"padding:10px;text-align:left;color:#0C447C\">ID</th>\n        <th style=\"padding:10px;text-align:left;color:#0C447C\">Pokémon</th>\n      </tr>\n    </thead>\n\n    <tbody>\n      {{ $json.ID.map((id, i) => `\n        <tr>\n          <td style=\"padding:9px 10px;border-bottom:1px solid #eee;color:#888\">\n            ${i + 1}\n          </td>\n          <td style=\"padding:9px 10px;border-bottom:1px solid #eee;font-family:monospace\">\n            ${id}\n          </td>\n          <td style=\"padding:9px 10px;border-bottom:1px solid #eee\">\n            ${$json.Nombre[i]}\n          </td>\n        </tr>\n      `).join('') }}\n    </tbody>\n  </table>\n\n  <div style=\"margin-top:18px;padding:12px;background:#E6F1FB;border-radius:6px;color:#0C447C;font-size:13px\">\n    Total registrados: <strong>{{ $items.length }}</strong>\n  </div>\n</div>",
